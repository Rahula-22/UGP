# Groq API key
# This is read by the app via `os.getenv("GROQ_API_KEY")`.
# Get a key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Note:
# - The Groq model can be selected in the app UI (sidebar).
# - If you add env support for model params later, you can document them here.

# ─── ShaadiGen AI Visual Studio · Virtual Try-On ───────────────────────────
# Used by shaadigen-ai and shaadigen-ai-classic Next.js apps (server-side only).
# Copy the vars you need into shaadigen-ai/.env.local and/or
# shaadigen-ai-classic/.env.local — never commit real secrets.

# Provider: aws-nova (default) | openai | vertex
TRYON_PROVIDER=aws-nova

# AWS Bedrock — Amazon Nova Canvas VIRTUAL_TRY_ON (primary)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Optional: store results in S3 (otherwise API returns a data URL)
TRYON_S3_BUCKET=
TRYON_S3_PUBLIC_BASE_URL=

# OpenAI Images Edit fallback (TRYON_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Azure OpenAI Images Edit (also TRYON_PROVIDER=openai)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-1
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Google Vertex AI virtual-try-on-001 (TRYON_PROVIDER=vertex)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Short-lived token for local/dev: `gcloud auth print-access-token`
GOOGLE_ACCESS_TOKEN=
